#!/bin/sh

### Add global hooks here

# Get branch name
BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)
# Extract JIRA key pattern (e.g. ABC-1234)
JIRA_ID=$(echo "$BRANCH_NAME" | grep -oE '[A-Z]+-[0-9]+')
# If a JIRA ID was found and not already in message, append it
if [ -n "$JIRA_ID" ]; then
  # Arguments:
  # $1 = path to the commit message file
  # $2 = type of commit (message, merge, squash, etc.)
  # Skip special cases like merges or squash commits
  if [[ "$2" != "merge" && "$2" != "squash" ]]; then
    echo "\n$JIRA_ID" >> "$1"
  fi
fi

### When global hooks processing is done, run the repo local hook if it exists
#
# Named after this hook rather than a hardcoded one: every hook here used to
# dispatch to the repo's *pre-commit* regardless of which hook it actually was,
# so a repo-local commit-msg or pre-rebase hook never ran while pre-commit ran
# from all of them.
#
# Resolved against --git-common-dir so this works in linked worktrees, where
# .git is a file rather than a directory, instead of the cwd-relative
# ./.git/hooks path this used before -- that only resolved when git happened to
# invoke the hook from the top of the working tree.
#
# Do NOT use `rev-parse --git-path hooks/...` here: that honours
# core.hooksPath, which points at this very directory, so the hook would
# re-exec itself until the process table fills. The self-guard below is
# belt-and-braces for the same reason.
#
# exec, so the local hook inherits stdin untouched and its exit status is ours.
LOCAL_HOOK="$(git rev-parse --git-common-dir)/hooks/$(basename "$0")"
if [ -x "$LOCAL_HOOK" ] && [ "$(cd "$(dirname "$LOCAL_HOOK")" && pwd -P)" != "$(cd "$(dirname "$0")" && pwd -P)" ]; then
  exec "$LOCAL_HOOK" "$@"
fi
exit 0
