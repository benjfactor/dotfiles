#!/bin/bash
# CPU history sparkline for the tmux status line. Takes a 1s sample at most
# every STEP seconds, so the history spans N x STEP.
# Usage: #(~/dotfiles/bin/tmux-cpu-sparkline [N] [STEP])   defaults 20, 5

n=${1:-20}
step=${2:-5}
hist="${TMPDIR:-/tmp}/tmux-cpu-sparkline.hist"

# tmux re-runs #() on every status redraw (up to 1/s), not per status-interval.
if [ ! -s "$hist" ] || (($(date +%s) - $(stat -f %m "$hist") >= step)); then
	idle=$(iostat -c 2 -w 1 -n 0 | awk 'END { print $3 }')
	case $idle in '' | *[!0-9]*) exit 0 ;; esac
	# Write via temp file + mv so overlapping calls never leave a torn history.
	{ tail -n $((n - 1)) "$hist" 2>/dev/null; echo $((100 - idle)); } >"$hist.$$" && mv "$hist.$$" "$hist"
fi
cpu=$(tail -n 1 "$hist")

bars=(▁ ▂ ▃ ▄ ▅ ▆ ▇ █)
spark= pad=
while read -r v; do spark+=${bars[v * 7 / 100]}; ((n--)); done < <(tail -n "$n" "$hist")
# Unfilled slots in vim's ~ colour so the graph keeps a fixed width.
while ((n-- > 0)); do pad+=▁; done

if ((cpu >= 80)); then color=red; elif ((cpu >= 30)); then color=yellow; else color=green; fi
printf 'CPU #[fg=colour12]%s#[fg=%s]%s %3d%%#[default]' "$pad" "$color" "$spark" "$cpu"
