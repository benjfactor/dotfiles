{
  "permissions": {
    "allow": [
      "Bash(cd *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(export *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git fetch *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git stash*)",
      "Bash(git worktree *)",
      "Bash(npx nx *)",
      "Bash(npm install*)",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go generate *)",
      "Bash(go install *)",
      "Bash(bq *)",
      "Edit(~/Projects/*)",
      "Edit(~/dotfiles/*)",
      "Edit(~/.claude/settings.json)",
      "Bash(git branch:*)",
      "Bash(gh auth:*)",
      "Bash(gh api:*)",
      "Bash(gh repo:*)",
      "Bash(gh search:*)",
      "Bash(git:*)",
      "Bash(mscli auth:*)",
      "Bash(gh pr:*)",
      "Bash(python3 ~/.claude/plugins/*)",
      "Bash(python3 ~/dotfiles/.claude/plugins/*)",
      "Bash(mkdir -p ~/.claude/wsu*)",
      "Bash(echo * >> ~/.claude/wsu/*)",
      "Bash(cat ~/.claude/wsu/*)",
      "Bash(tail * ~/.claude/wsu/*)",
      "WebFetch(domain:github.com)",
      "Artifact",
      "Bash(bash run.sh -s)",
      "Bash(date -u +%Y-%m-%dT%H:%M:%SZ)",
      "Bash(echo \"PID: $!\")",
      "Bash(export NODE_OPTIONS=--max_old_space_size=12000)",
      "Bash(find . -name \"*.md\" -type f ! -path \"*/vendor/*\" ! -path \"*/sdks/*\" -exec grep -l \"tesseract\\\\|MySQL\\\\|architecture\\\\|design decision\" {} \\\\;)",
      "Bash(git worktree:*)",
      "Bash(go generate:*)",
      "Bash(go install:*)",
      "Bash(go test:*)",
      "Bash(grep -E \"\\\\.\\(go|sql|proto\\)$\")",
      "Bash(grep -E \"\\\\.\\(md|txt\\)$\")",
      "Bash(mscli:*)",
      "Bash(node_modules/.bin/nx run:*)",
      "Bash(sleep 2)",
      "Bash(timeout 50 gcloud logging read 'resource.labels.namespace_name=\"email-prod\" \"Started Outlook notification workflow\"' --project=repcore-prod --freshness=50m --limit=400 '--format=value\\(timestamp\\)')",
      "Bash(true)",
      "Skill(artifact-design)",
      "Skill(conversation-diagnostics)",
      "Skill(loop)",
      "Skill(update-config)",
      "Skill(vendasta-dev-agent-toolkit:content-fetcher)",
      "Skill(vendasta-dev-agent-toolkit:dev-session-token)",
      "Skill(vendasta-dev-agent-toolkit:jira-context)",
      "WebFetch(domain:claude.ai)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:vendasta.jira.com)",
      "WebSearch",
      "mcp__claude_ai_Atlassian__addCommentToJiraIssue",
      "mcp__claude_ai_Atlassian__atlassianUserInfo",
      "mcp__claude_ai_Atlassian__createConfluenceInlineComment",
      "mcp__claude_ai_Atlassian__createConfluencePage",
      "mcp__claude_ai_Atlassian__createIssueLink",
      "mcp__claude_ai_Atlassian__createJiraIssue",
      "mcp__claude_ai_Atlassian__editJiraIssue",
      "mcp__claude_ai_Atlassian__fetch",
      "mcp__claude_ai_Atlassian__getAccessibleAtlassianResources",
      "mcp__claude_ai_Atlassian__getConfluencePage",
      "mcp__claude_ai_Atlassian__getConfluencePageDescendants",
      "mcp__claude_ai_Atlassian__getConfluencePageFooterComments",
      "mcp__claude_ai_Atlassian__getConfluencePageInlineComments",
      "mcp__claude_ai_Atlassian__getIssueLinkTypes",
      "mcp__claude_ai_Atlassian__getJiraIssue",
      "mcp__claude_ai_Atlassian__getJiraIssueRemoteIssueLinks",
      "mcp__claude_ai_Atlassian__getJiraProjectIssueTypesMetadata",
      "mcp__claude_ai_Atlassian__getTransitionsForJiraIssue",
      "mcp__claude_ai_Atlassian__getVisibleJiraProjects",
      "mcp__claude_ai_Atlassian__lookupJiraAccountId",
      "mcp__claude_ai_Atlassian__search",
      "mcp__claude_ai_Atlassian__searchAtlassian",
      "mcp__claude_ai_Atlassian__searchConfluenceUsingCql",
      "mcp__claude_ai_Atlassian__searchJiraIssuesUsingJql",
      "mcp__claude_ai_Atlassian__transitionJiraIssue",
      "mcp__claude_ai_Atlassian__updateConfluencePage"
    ],
    "additionalDirectories": [
      "~/Projects/"
    ]
  },
  "model": "Opus",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/stamp-prompt.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/branch-check.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Bottle.aiff"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notif-log.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Submarine.aiff"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Basso.aiff"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "vendasta-dev-agent-toolkit@vendasta-dev-agent-toolkit": true,
    "gopls-lsp@claude-plugins-official": true,
    "compound-engineering@compound-engineering-plugin": true,
    "vendasta-pr-studio@vendasta-dev-agent-toolkit": true
  },
  "extraKnownMarketplaces": {
    "vendasta-dev-agent-toolkit": {
      "source": {
        "source": "git",
        "url": "https://github.com/vendasta/dev-agent-toolkit.git"
      },
      "autoUpdate": true
    },
    "compound-engineering-plugin": {
      "source": {
        "source": "github",
        "repo": "EveryInc/compound-engineering-plugin"
      }
    }
  },
  "effortLevel": "high",
  "pluginConfigs": {},
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "editorMode": "vim",
  "verbose": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(mscli auth session --env prod*)"
    ],
    "environment": [
      "### Org-wide",
      "**Organization**: Vendasta (github.com/vendasta org appears in sibling repo remotes; not corroborated as the working repo, treated as context only)",
      "**Cloud provider(s)**: Google Cloud (gcloud SDK installed; `gcloud secrets` marker found)",
      "**Repository visibility**: None configured — not queryable here (no origin remote in this repo) and current repo has zero tracked files",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: gcloud Secret Manager (`gcloud secrets` marker found in config scan)",
      "**Default / protected branches**: None configured — origin/HEAD unset, no remotes in this repo",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Source control**: The trusted repo and its remote(s) only (no additional orgs configured) — as scoped by the Trusted repo and Repository visibility entries above",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment (hyphen/underscore/dot-delimited — e.g. matches `prod-db`, not `producer`)",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development",
      "**Trusted repo**: The git repository the agent started in (/Users/bhingston/Projects) and its configured remote(s) — currently no remotes configured and no tracked files",
      "**Org-specific CLIs**: mscli (Vendasta internal CLI, seen in global CLAUDE.md and used for auth session against demo/prod environments)",
      "No 'routine under <user>/ prefix' qualifiers found"
    ]
  },
  "voiceEnabled": true
}
