# Third-party plugins: fetched by vim-plug and TPM, never committed.
# Committing them created gitlinks with no .gitmodules, which clone as empty
# directories -- silently breaking every plugin on a fresh machine.
vimide/.vim/plugged/*
.tmux/plugins/*
.vim/bundle/*
.vim/plugged/*
.vim/erics_vim_syntax_and_color_highlighting-master/
.DS_Store
.vim/DS_Store
Session.vim
.claude/
__pycache__/

# Sublime writes these into the linked Packages/User directory at runtime.
# The CA bundle is regenerated by Package Control on first launch and the
# rest is per-machine state, so tracking them just creates diff noise.
sublime/User/Package Control.user-ca-bundle
sublime/User/Package Control.last-run
sublime/User/*.cache
sublime/User/oscrypto-ca-bundle.crt
